+function courseHint(w, cls) {
+  if (typeof academyCourseFor !== 'function') return '';
+  const c = academyCourseFor(w);
+  if (!c) return '';
+  return `<a href="${esc(c.url)}" class="${cls || ''} block text-sm rounded-xl bg-emerald-50 border border-emerald-100 px-4 py-3 text-emerald-900 hover:bg-emerald-100"><b>📚 Поглибити тему:</b> курс Академії «${esc(c.title)}» →</a>`;
+}
+function renderAcademy() {
+  const box = $('#academyList');
+  if (!box) return;
+  if (typeof ACADEMY === 'undefined') { $('#academy').classList.add('hidden'); return; }
+  $('#academyAll').href = ACADEMY.url;
+  box.innerHTML = ACADEMY.courses.map(c => `
+    <article class="bg-white rounded-3xl border border-emerald-100 p-6 flex flex-col">
+      <div class="flex flex-wrap gap-2 mb-3">${badge(c.code, 'bg-slate-100 text-slate-700')}${c.status === 'open' ? badge('Запис відкрито', 'bg-emerald-100 text-emerald-800') : badge('Незабаром', 'bg-amber-100 text-amber-800')}</div>
+      <h3 class="font-extrabold text-lg text-vagblue mb-1">${esc(c.title)}</h3>
+      <p class="text-sm font-bold text-slate-500 mb-3">${esc(c.audience)}</p>
+      <p class="text-sm text-slate-600 mb-5">${esc(c.summary)}</p>
+      ${c.status === 'open' && c.url
+        ? `<a href="${esc(c.url)}" class="mt-auto text-center bg-vaggreen text-white py-3 rounded-xl font-bold hover:bg-vagblue transition">Про курс і запис →</a>`
+        : `<span class="mt-auto text-center bg-slate-100 text-slate-500 py-3 rounded-xl font-bold">Курс готується</span>`}
+    </article>`).join('');
+}
